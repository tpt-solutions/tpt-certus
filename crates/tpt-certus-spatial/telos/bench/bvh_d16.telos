            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 9 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 10 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 11 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 12 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
