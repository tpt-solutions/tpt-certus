        }
        if key >= out.lo + 13 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 14 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 15 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
        if key >= out.lo + 16 {
            mutate state { out.lo = out.lo + 1; out.hi = out.hi + 1 }
        } else {
            mutate state { out.hi = out.hi + 1 }
        }
    }
