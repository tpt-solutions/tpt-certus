// ============================================================================
// ray_intersects_aabb — Phase 1 draft (tpt-telos v0.2.0)
//
// This is the *authored* two-layer contract from spec.txt Section 6, the target
// contract for the Phase 1 proof-of-concept.  It is written out verbatim here
// as the design source of truth, with the machine-verifiable subset expressed
// as tpt-telos code below.
//
// == Ideal layer (QF_LRA, exact rationals) ==
//   requires: aabb.min.x <= aabb.max.x && aabb.min.y <= aabb.max.y &&
//             aabb.min.z <= aabb.max.z
//   requires: t_max > 0.0                                    // bounded domain
//   requires: ray.dir.x != 0.0 || ray.dir.y != 0.0 || ray.dir.z != 0.0
//   ensures:  result.is_some() ==>
//               i.t_near >= 0.0 && i.t_near <= i.t_far && i.t_near <= t_max
//   ensures:  origin inside AABB (inclusive, boundary counts) ==>
//               result.is_some() && result.unwrap().t_near == 0.0
//
// == Realization layer (f64, auto-derived epsilon) ==
//   ensures:  ideal.is_some() == result.is_some()          // no false negatives
//   ensures:  ideal.is_some() ==>
//               |t_near - ideal.t_near| <= EPSILON_T && |t_far - ideal.t_far| <= EPSILON_T
//   // EPSILON_T derived by tpt-certus from IEEE-754 interval arithmetic over
//   // the slab operation graph; published per-build in the Proof Certificate.
//
// == Expression status under tpt-telos v0.2.0 (source-reviewed + empirically
//    re-verified with the installed binary) ==
//   - `==>` implication and symbolic `let ideal = ...` bindings are not in the
//     grammar (no `==>` token; FatArrow `=>` exists only for match arms).
//   - `if`/`else` IS supported in function bodies with a single comparison
//     guard: all six relations (`==`, `!=`, `<`, `<=`, `>`, `>=`), including
//     field operands.  Compound (`&&`/`||`) guards are rejected.  `match` with
//     state-mutating arms is rejected; non-mutating `let`/`return` parse but
//     are no-ops in the IR body analysis (no return-value verification yet).
//   - Mutation via `mutate state { ... }`; plain `=`/`+=`/`-=` assignments also
//     parse and verify inside if/else arms (confirmed with the binary).
//   - `telos build`/`transpile` fails *before* codegen for this file with
//     `internal error: no verification problem extracted for function
//     '<name>'` for every function whose body contains an `if` (re-probed
//     v0.2.0: straight-line `mutate`-only functions transpile fine; guarded
//     ones abort the whole file).  This is the primary reason the codegen path
//     is unusable for this contract — on top of the Float64 -> i64 demotion and
//     the invariant-only struct fields being dropped.  `telos verify` (and
//     `telos verify --json`) handles the file correctly, so the Proof
//     Certificate for this contract is assembled from the verify report, not
//     from `telos-proof.json`.
//   - DNF (`&&`-free but `||`-joined) `requires` clauses parse, but the body
//     analysis does *not* use them to prune branches: a function that requires
//     `dx != 0 || dy != 0 || dz != 0` and returns when any component is
//     non-zero still reports a branch with the counterexample
//     `{dx=0, dy=0, dz=0}`.  Likewise a `!=` guard (`if dir != 0`) is lowered
//     to a disjunction, and its negated (unreachable-under-requires) path is
//     still explored as reachable — so the exact-zero direction gate cannot yet
//     be machine-verified as a *branch* shape.  `<=`/`>=`/`==` single-relation
//     guards *are* pruned correctly (that is why the slab gates verify).
//   - Float32/Float64 parse; IR is QF_LRA over integer/real atoms — no IEEE-754
//     interval arithmetic, no rounding-error ε bounds.  `telos build`/`transpile`
//     output is not type-faithful for our draft (auto-inferred `Box` drops
//     invariant-only fields `min_z`/`max_y` → generated Rust does not compile;
//     `Float64` params render as `i64`).  The realization layer must wait for
//     upstream float semantics or our own error-bound layer.
//
// Tracked in todo.md Phase 1.2 / 1.3 / "Open risks".  The machine-verified
// subset is the slab *shapes* below: relational/field single-comparison guards,
// `=`/`+=` mutating arms, and hit decision logic — expressed over Int atoms
// since the IR has no float semantics.  This file must pass `telos verify`
// (CI gate) and is the canonical draft to upgrade in place.
// ============================================================================

@boundary(cpu_bound)
module RayAabb {
    // spec.txt Section 6 requires: aabb.min <= aabb.max on all axes.
    // This is a machine-checked invariant on the Box type.
    invariant Box {
        min_x <= max_x && min_y <= max_y && min_z <= max_z
    }

    struct Hit {
        t_near: Float64,
        t_far: Float64,
        flag: Int,
    }

    // Ideal-layer slab accumulator over QF_LRA integer atoms: the bounds that
    // the slab method narrows per axis.
    struct Bounds {
        t_min: Int,
        t_max_slab: Int,
    }

    // Boundary-face slice of the spec contract (Appendix A closure): an origin
    // whose x-coordinate equals the min-x face is treated as *inside* the AABB.
    // v0.2.0 verifies single-comparison equality gates plus a `+=` mutation arm.
    func boundary_min_x(b: Box, px: Float64, py: Float64, pz: Float64, mut out: Hit)
        requires b.min_x <= b.max_x
        requires px == b.min_x
        requires py >= b.min_y
        requires pz <= b.max_z
        requires out.flag == 0
        ensures out.flag == 1
    {
        mutate state {
            out.flag += 1
        }
    }

    // Slab hit gate (relational single-comparison guard): once the slabs have
    // narrowed t_min / t_max_slab, the hit decision is `t_max_slab >= t_min`
    // with an entry point non-negative.  Under the domain assumptions the guard
    // is provably taken and the hit is recorded.  This is the control-flow shape
    // the earlier draft could not express; empirically verified with the binary.
    func slab_hit_decided(t_min: Int, t_max_slab: Int, mut out: Hit)
        requires out.flag == 0
        requires t_max_slab >= t_min
        requires t_min >= 0
        requires t_max_slab >= 0
        ensures out.flag == 1
    {
        if t_max_slab >= t_min {
            if t_min >= 0 {
                mutate state {
                    out.flag = 1
                }
            }
        }
    }

    // Slab contraction gate: t_min is only ever raised (never lowered) toward
    // the tighter of the two slab crossings — the monotone-tightening property
    // the slab method relies on for `t_min <= t_max_slab` to be preserved.
    func tighten_t_min(left: Int, right: Int, mut out: Bounds)
        requires out.t_min <= out.t_max_slab
        requires left <= out.t_max_slab
        requires right <= out.t_max_slab
        ensures out.t_min <= out.t_max_slab
    {
        if right >= left {
            mutate state {
                out.t_min = left
            }
        } else {
            mutate state {
                out.t_min = right
            }
        }
    }

    // Slab overlap/OOB split: records whether slab ranges still overlap given
    // the current bounded-domain distance.  Uses relational `>=` guards and `=`
    // assignments in both arms (the constructs the earlier draft claimed were
    // unparseable).
    func domain_overlap_detected(t_min: Int, t_max_slab: Int, mut out: Hit)
        requires out.flag == 0
        ensures out.flag == 0 || out.flag == 1
    {
        if t_max_slab >= t_min {
            mutate state {
                out.flag = 1
            }
        } else {
            mutate state {
                out.flag = 0
            }
        }
    }

    // Explicit bounded domain (`requires: t_max > 0.0`): the no-false-negative
    // claim is only meaningful up to t_max.  An entry distance that lies inside
    // the bounded domain is a valid hit, so the acceptance gate is exactly
    // `t_near <= t_max` under `t_max > 0 && t_near >= 0`.  Single-relation
    // guard, machine-verified with the installed v0.2.0 binary.
    func t_max_domain_accepts(t_max: Int, t_near: Int, mut out: Hit)
        requires out.flag == 0
        requires t_max > 0
        requires t_near >= 0
        requires t_near <= t_max
        ensures out.flag == 1
    {
        if t_near <= t_max {
            mutate state {
                out.flag = 1
            }
        }
    }

    // Boundary faces: an origin whose coordinate equals a face is treated as
    // *inside* the AABB (Appendix A closure).  `boundary_min_x` above is the
    // min-x slice; the five remaining faces are spelled out here so all six
    // faces of the boundary-case gap have a machine-verified equality gate.
    // Each slice is a straight-line `mutate` body, so it both verifies and
    // transpiles (see the header note on codegen).
    func boundary_max_x(b: Box, px: Float64, py: Float64, pz: Float64, mut out: Hit)
        requires b.min_x <= b.max_x
        requires px == b.max_x
        requires py >= b.min_y
        requires py <= b.max_y
        requires pz >= b.min_z
        requires pz <= b.max_z
        requires out.flag == 0
        ensures out.flag == 1
    {
        mutate state {
            out.flag += 1
        }
    }

    func boundary_min_y(b: Box, px: Float64, py: Float64, pz: Float64, mut out: Hit)
        requires b.min_y <= b.max_y
        requires py == b.min_y
        requires px >= b.min_x
        requires px <= b.max_x
        requires pz >= b.min_z
        requires pz <= b.max_z
        requires out.flag == 0
        ensures out.flag == 1
    {
        mutate state {
            out.flag += 1
        }
    }

    func boundary_max_y(b: Box, px: Float64, py: Float64, pz: Float64, mut out: Hit)
        requires b.min_y <= b.max_y
        requires py == b.max_y
        requires px >= b.min_x
        requires px <= b.max_x
        requires pz >= b.min_z
        requires pz <= b.max_z
        requires out.flag == 0
        ensures out.flag == 1
    {
        mutate state {
            out.flag += 1
        }
    }

    func boundary_min_z(b: Box, px: Float64, py: Float64, pz: Float64, mut out: Hit)
        requires b.min_z <= b.max_z
        requires pz == b.min_z
        requires px >= b.min_x
        requires px <= b.max_x
        requires py >= b.min_y
        requires py <= b.max_y
        requires out.flag == 0
        ensures out.flag == 1
    {
        mutate state {
            out.flag += 1
        }
    }

    func boundary_max_z(b: Box, px: Float64, py: Float64, pz: Float64, mut out: Hit)
        requires b.min_z <= b.max_z
        requires pz == b.max_z
        requires px >= b.min_x
        requires px <= b.max_x
        requires py >= b.min_y
        requires py <= b.max_y
        requires out.flag == 0
        ensures out.flag == 1
    {
        mutate state {
            out.flag += 1
        }
    }
}